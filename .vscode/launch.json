{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch & Debug API (nx serve api)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "api"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "restart": true,
      "outFiles": ["${workspaceFolder}/dist/apps/api/**/*.(m|c|)js", "!**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Running API (localhost:9229)",
      "port": 9229,
      "restart": true,
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/apps/api/**/*.(m|c|)js", "!**/node_modules/**"]
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug via JavaScript Terminal (npx nx serve api)",
      "command": "npx nx serve api"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Unit Test (Jest)",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest",
      "args": [
        "--runInBand",
        "--testPathPattern",
        "${fileBasenameNoExtension}",
        "--config",
        "apps/api/jest.config.cts"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
