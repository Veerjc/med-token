    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/jest": "24.0.2",
    "@nx/js": "^24.0.2",
    "@nx/nest": "^24.0.2",
    "@nx/node": "24.0.2",
    "@nx/web": "24.0.2",
    "@nx/webpack": "24.0.2",
    "@nx/workspace": "24.0.2",
    "@schematics/angular": "~22.2.0",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/joi": "^17.2.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
