{
  "name": "@medical-proj/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:all": "nx run-many -t serve -p api web mobile",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "dev:mobile": "nx serve mobile",
    "build:all": "CI=true nx run-many -t build",
    "test:all": "CI=true nx run-many -t test",
    "lint:all": "CI=true nx run-many -t lint",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "mobile:sync": "nx build mobile && cd apps/mobile && npx cap sync",
    "mobile:ios": "cd apps/mobile && npx cap open ios",
    "mobile:android": "cd apps/mobile && npx cap open android",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t medical-api:latest .",
    "docker:db:up": "docker compose up -d",
    "docker:db:down": "docker compose down",
    "docker:db:logs": "docker compose logs -f",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
