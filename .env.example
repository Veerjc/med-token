# ==============================================
# Environment Configuration - medical-proj
# ==============================================

# Application Runtime
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
WEB_PORT=4200
MOBILE_PORT=4201

# PostgreSQL Database (Docker Compose / Amazon RDS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medical_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_db?schema=public

# Redis In-Memory Store & Token Queue (Docker Compose / Amazon ElastiCache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & Security
JWT_ACCESS_SECRET=development_jwt_access_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=development_jwt_refresh_secret_key_minimum_32_characters_long
JWT_REFRESH_EXPIRATION=7d

# AWS Cloud Target (ADR-006)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=medical-proj-documents-dev
